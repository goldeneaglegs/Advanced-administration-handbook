{
  "name": "gegs-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Golden Eagle GS operational platform. Adjacent to the existing WordPress site; owns recruitment and government-service workflows.",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "node server.ts",
    "build": "next build",
    "start": "NODE_ENV=production node server.ts",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "secret:scan": "node scripts/secret-scan.mjs",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:generate": "prisma generate",
    "gate": "npm run lint && npm run format:check && npm run typecheck && npm run tokens:check && npm run tokens:discipline && npm run i18n:report && npm run contrast:check && npm run test:unit && npm run secret:scan",
    "test": "vitest run",
    "contrast:check": "node scripts/check-contrast.mjs",
    "tokens:generate": "node scripts/generate-css-tokens.ts",
    "tokens:check": "node scripts/generate-css-tokens.ts --check",
    "tokens:discipline": "node scripts/check-token-discipline.mjs",
    "i18n:report": "node scripts/report-untranslated-keys.ts",
    "i18n:literals": "node scripts/check-literal-strings.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.705.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.1.0",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.17.0",
    "@next/eslint-plugin-next": "^15.1.0",
    "@playwright/test": "^1.49.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "prisma": "^6.1.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
