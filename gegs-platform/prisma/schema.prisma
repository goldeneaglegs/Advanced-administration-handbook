generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model application_stage_history {
  id                                                                       String           @id @default(dbgenerated("uuidv7()")) @db.Uuid
  application_id                                                           String           @db.Uuid
  from_stage_id                                                            String?          @db.Uuid
  to_stage_id                                                              String           @db.Uuid
  changed_by_user_id                                                       String?          @db.Uuid
  reason                                                                   String?
  changed_at                                                               DateTime         @default(now()) @db.Timestamptz(6)
  applications                                                             applications     @relation(fields: [application_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users                                                                    users?           @relation(fields: [changed_by_user_id], references: [id], onUpdate: NoAction)
  pipeline_stages_application_stage_history_from_stage_idTopipeline_stages pipeline_stages? @relation("application_stage_history_from_stage_idTopipeline_stages", fields: [from_stage_id], references: [id], onDelete: Restrict, onUpdate: NoAction)
  pipeline_stages_application_stage_history_to_stage_idTopipeline_stages   pipeline_stages  @relation("application_stage_history_to_stage_idTopipeline_stages", fields: [to_stage_id], references: [id], onUpdate: NoAction)

  @@index([application_id, changed_at], map: "application_stage_history_application")
}

model applications {
  id                        String                      @id @default(dbgenerated("uuidv7()")) @db.Uuid
  requirement_id            String                      @db.Uuid
  candidate_profile_id      String                      @db.Uuid
  stage_id                  String                      @db.Uuid
  stage_changed_at          DateTime                    @default(now()) @db.Timestamptz(6)
  owner_user_id             String?                     @db.Uuid
  outcome_reason            String?
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  application_stage_history application_stage_history[]
  candidate_profiles        candidate_profiles          @relation(fields: [candidate_profile_id], references: [id], onUpdate: NoAction)
  users                     users?                      @relation(fields: [owner_user_id], references: [id], onUpdate: NoAction)
  requirements              requirements                @relation(fields: [requirement_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  pipeline_stages           pipeline_stages             @relation(fields: [stage_id], references: [id], onUpdate: NoAction)

  @@unique([requirement_id, candidate_profile_id], map: "applications_one_per_candidate_per_requirement")
  @@index([candidate_profile_id], map: "applications_candidate")
  @@index([owner_user_id], map: "applications_owner")
  @@index([stage_id], map: "applications_stage")
  @@index([stage_changed_at], map: "applications_stage_changed_at")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model audit_log {
  id            String   @id @default(dbgenerated("uuidv7()")) @db.Uuid
  actor_user_id String?  @db.Uuid
  actor_ip      String?  @db.Inet
  action        String
  subject_type  String
  subject_id    String?  @db.Uuid
  before_json   Json?
  after_json    Json?
  request_id    String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)
  users         users?   @relation(fields: [actor_user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([action, created_at(sort: Desc)], map: "audit_log_action")
  @@index([actor_user_id, created_at(sort: Desc)], map: "audit_log_actor")
  @@index([created_at(sort: Desc)], map: "audit_log_created_at")
  @@index([subject_type, subject_id, created_at(sort: Desc)], map: "audit_log_subject")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model candidate_profiles {
