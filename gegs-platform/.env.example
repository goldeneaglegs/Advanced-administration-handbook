# Copy to .env for local development. NEVER commit a real .env.
# Production values come from the platform secret manager and are injected as
# environment variables at run time (Phase 1 §15.2).

NODE_ENV=development

# --- PostgreSQL -------------------------------------------------------------
# Local development only. The credentials below match docker-compose.yml and
# are intentionally non-secret local fixtures, not production values.
DATABASE_URL=postgresql://gegs:gegs_local_dev@127.0.0.1:5432/gegs?schema=public

# --- Object storage (S3-compatible, PRIVATE bucket) -------------------------
# Local development points at MinIO. In production this is Amazon S3 pinned to
# the approved GCC region, and the bucket has no public read policy or ACL.
STORAGE_ENDPOINT=http://127.0.0.1:9000
STORAGE_REGION=me-central-1
STORAGE_BUCKET=gegs-documents-local
STORAGE_ACCESS_KEY_ID=gegs_local_minio
STORAGE_SECRET_ACCESS_KEY=gegs_local_minio_secret
# MinIO needs path-style addressing; Amazon S3 does not.
STORAGE_FORCE_PATH_STYLE=true

# --- Application ------------------------------------------------------------
APP_ORIGIN=http://127.0.0.1:3000
